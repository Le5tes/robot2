<launch>
  <include file="$(find-pkg-share rosbridge_server)/launch/rosbridge_websocket_launch.xml"/>
  
  <node name="web_video_server" pkg="web_video_server" exec="web_video_server"/>
  <node name="control_listener" pkg="robot" exec="control_listener"/>
  
  <node name="vision_node" pkg="robot" exec="vision_node">
    <param name="camera_width" value="640"/>
    <param name="camera_height" value="480"/>
    <param name="camera_framerate" value="15"/>
    <param name="detector_type" value="haar"/>
    <param name="debug_draw_boxes" value="true"/>
  </node>
</launch>